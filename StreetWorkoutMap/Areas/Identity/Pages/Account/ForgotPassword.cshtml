@page
@model ForgotPasswordModel

@{
    ViewData["Title"] = "Забравена парола";
}

<section class="auth-page">

    <div class="auth-card">

        <div class="auth-header">
            <div class="auth-eyebrow">
                SW-MAP
            </div>

            <h1>Забравена парола?</h1>

            <p>
                Въведи имейл адреса на профила си и ще ти изпратим
                линк за задаване на нова парола.
            </p>
        </div>

        <form method="post"
              class="auth-form">

            <div asp-validation-summary="ModelOnly"
                 class="auth-validation-summary"
                 role="alert">
            </div>

            <div class="auth-field">
                <label asp-for="Input.Email">
                    Имейл
                </label>

                <input asp-for="Input.Email"
                       class="form-control"
                       autocomplete="email"
                       aria-required="true"
                       placeholder="example@email.com" />

                <span asp-validation-for="Input.Email"
                      class="auth-validation-message">
                </span>
            </div>

            <button type="submit"
                    class="auth-primary-button">
                Изпрати линк за възстановяване
            </button>

        </form>

        <div class="auth-footer">
            <span>Спомни си паролата?</span>

            <a asp-page="./Login"
               class="auth-link auth-link-strong">
                Към вход
            </a>
        </div>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}