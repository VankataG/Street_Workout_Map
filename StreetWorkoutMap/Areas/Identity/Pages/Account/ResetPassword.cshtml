@page
@model ResetPasswordModel

@{
    ViewData["Title"] = "Нова парола";
}

<section class="auth-page">

    <div class="auth-card">

        <div class="auth-header">
            <div class="auth-eyebrow">
                SW-MAP
            </div>

            <h1>Задай нова парола</h1>

            <p>
                Въведи имейл адреса на профила и избери
                нова парола за вход.
            </p>
        </div>

        <form method="post"
              class="auth-form">

            <div asp-validation-summary="ModelOnly"
                 class="auth-validation-summary"
                 role="alert">
            </div>

            <input asp-for="Input.Code"
                   type="hidden" />

            <div class="auth-field">
                <label asp-for="Input.Email">
                    Имейл
                </label>

                <input asp-for="Input.Email"
                       class="form-control"
                       autocomplete="email"
                       aria-required="true"
                       placeholder="example@email.com" />

                <span asp-validation-for="Input.Email"
                      class="auth-validation-message">
                </span>
            </div>

            <div class="auth-field">
                <label asp-for="Input.Password">
                    Нова парола
                </label>

                <input asp-for="Input.Password"
                       class="form-control"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="Въведи нова парола" />

                <span asp-validation-for="Input.Password"
                      class="auth-validation-message">
                </span>
            </div>

            <div class="auth-field">
                <label asp-for="Input.ConfirmPassword">
                    Потвърди новата парола
                </label>

                <input asp-for="Input.ConfirmPassword"
                       class="form-control"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="Повтори новата парола" />

                <span asp-validation-for="Input.ConfirmPassword"
                      class="auth-validation-message">
                </span>
            </div>

            <div class="auth-password-rules">
                <p>Паролата трябва да съдържа:</p>

                <ul>
                    <li>поне 8 символа;</li>
                    <li>условията за сигурност, зададени от SW-MAP.</li>
                </ul>
            </div>

            <button type="submit"
                    class="auth-primary-button">
                Запази новата парола
            </button>

        </form>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}