@page
@model ResetPasswordConfirmationModel

@{
    ViewData["Title"] = "Паролата е променена";
}

<section class="auth-page">

    <div class="auth-card auth-message-card">

        <div class="auth-message-icon auth-message-icon-success">
            ✓
        </div>

        <div class="auth-header auth-message-header">
            <div class="auth-eyebrow">
                SW-MAP
            </div>

            <h1>Паролата е променена</h1>

            <p>
                Новата ти парола е запазена успешно.
                Вече можеш да влезеш в профила си.
            </p>
        </div>

        <a asp-page="./Login"
           class="auth-primary-link">
            Вход в профила
        </a>

    </div>

</section>