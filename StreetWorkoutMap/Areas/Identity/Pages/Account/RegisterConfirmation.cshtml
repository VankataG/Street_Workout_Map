@page
@model RegisterConfirmationModel

@{
    ViewData["Title"] = "Потвърждение на регистрацията";
}

<div class="container py-5">
    <div class="text-center">
        <h1 class="mb-3">Регистрацията е успешна!</h1>

        <p class="mb-2">
            Изпратихме линк за потвърждение на:
        </p>

        <p class="fw-bold">
            @Model.Email
        </p>

        <p>
            Потвърди имейл адреса си, преди да влезеш в профила.
        </p>

        <a asp-page="./Login" class="btn btn-primary mt-3">
            Към вход
        </a>
    </div>
</div>