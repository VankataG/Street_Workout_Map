@page
@model ForgotPasswordConfirmation

@{
    ViewData["Title"] = "Провери имейла си";
}

<section class="auth-page">

    <div class="auth-card auth-message-card">

        <div class="auth-message-icon">
            ✉
        </div>

        <div class="auth-header auth-message-header">
            <div class="auth-eyebrow">
                SW-MAP
            </div>

            <h1>Провери имейла си</h1>

            <p>
                Ако съществува потвърден профил с този имейл адрес,
                изпратихме линк за задаване на нова парола.
            </p>
        </div>

        <div class="auth-info-box">
            Провери и папка „Спам“, ако съобщението не се появи
            в основната ти входяща поща.
        </div>

        <a asp-page="./Login"
           class="auth-primary-link">
            Към вход
        </a>

    </div>

</section>