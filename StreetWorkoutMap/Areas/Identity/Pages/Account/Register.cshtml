        <footer class="auth-footer">
            <span>Вече имаш профил?</span>

            <a asp-page="./Login"
               asp-route-returnUrl="@Model.ReturnUrl"
               class="auth-link auth-link-strong">
                Влез
            </a>
        </footer>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}