@page
@model RegisterModel

@{
    ViewData["Title"] = "Регистрация";
}

<section class="auth-page" aria-labelledby="register-title">
    <div class="auth-card">
        <header class="auth-header">
            <p class="auth-eyebrow">Присъедини се към SW-MAP</p>
            <h1 id="register-title">Създай профил</h1>
            <p>
                Регистрирай се, за да добавяш нови площадки
                и да управляваш своите.
            </p>
        </header>

        <form id="registerForm"
              asp-route-returnUrl="@Model.ReturnUrl"
              method="post"
              class="auth-form">

            <div asp-validation-summary="ModelOnly"
                 class="auth-validation-summary"
                 role="alert"></div>

            <div class="auth-name-grid">
                <div class="auth-field">
                    <label asp-for="Input.FirstName"></label>

                    <input asp-for="Input.FirstName"
                           class="form-control"
                           autocomplete="given-name"
                           aria-required="true"
                           placeholder="Иван" />

                    <span asp-validation-for="Input.FirstName"
                          class="auth-validation-message"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Input.LastName"></label>

                    <input asp-for="Input.LastName"
                           class="form-control"
                           autocomplete="family-name"
                           aria-required="true"
                           placeholder="Иванов" />

                    <span asp-validation-for="Input.LastName"
                          class="auth-validation-message"></span>
                </div>
            </div>

            <div class="auth-field">
                <label asp-for="Input.Email"></label>

                <input asp-for="Input.Email"
                       class="form-control"
                       autocomplete="username"
                       inputmode="email"
                       aria-required="true"
                       placeholder="name@example.com" />

                <span asp-validation-for="Input.Email"
                      class="auth-validation-message"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Input.Password"></label>

                <input asp-for="Input.Password"
                       class="form-control"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="Въведи сигурна парола" />

                <span asp-validation-for="Input.Password"
                      class="auth-validation-message"></span>
            </div>

            <div class="auth-password-rules">
                <p>Паролата трябва да съдържа:</p>

                <ul>
                    <li>Минимум 8 символа</li>
                    <li>Поне една главна буква</li>
                    <li>Поне една малка буква</li>
                    <li>Поне една цифра</li>
                </ul>
            </div>

            <div class="auth-field">
                <label asp-for="Input.ConfirmPassword"></label>

                <input asp-for="Input.ConfirmPassword"
                       class="form-control"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="Въведи паролата отново" />

                <span asp-validation-for="Input.ConfirmPassword"
                      class="auth-validation-message"></span>
            </div>

            <button id="registerSubmit"
                    type="submit"
                    class="auth-primary-button">
                Създай профил
            </button>
        </form>



        @if ((Model.ExternalLogins?.Count ?? 0) > 0)
        {
            <div class="auth-divider">
                <span>или продължи с</span>
            </div>

            <form asp-page="./ExternalLogin"
                  asp-route-returnUrl="@Model.ReturnUrl"
                  method="post"
                  class="auth-social-grid">

                @foreach (var provider in Model.ExternalLogins!)
                {
                    if (provider.Name == "Google")
                    {
                        <button type="submit"
                                class="auth-social-button"
                                name="provider"
                                value="@provider.Name"
                                title="Продължи с Google">

                            <svg class="auth-social-icon"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <path fill="#4285F4"
                                      d="M21.6 12.23c0-.71-.06-1.4-.18-2.07H12v3.92h5.38a4.6 4.6 0 0 1-2 3.02v2.51h3.24c1.9-1.75 2.98-4.33 2.98-7.38Z" />
                                <path fill="#34A853"
                                      d="M12 22c2.7 0 4.97-.89 6.63-2.4l-3.24-2.51c-.9.6-2.05.96-3.39.96-2.61 0-4.82-1.76-5.61-4.13H3.04v2.59A10 10 0 0 0 12 22Z" />
                                <path fill="#FBBC05"
                                      d="M6.39 13.92A6 6 0 0 1 6.08 12c0-.67.11-1.32.31-1.92V7.49H3.04A10 10 0 0 0 2 12c0 1.61.38 3.14 1.04 4.51l3.35-2.59Z" />
                                <path fill="#EA4335"
                                      d="M12 5.95c1.47 0 2.78.5 3.82 1.49l2.87-2.87C16.96 2.96 14.7 2 12 2a10 10 0 0 0-8.96 5.49l3.35 2.59C7.18 7.71 9.39 5.95 12 5.95Z" />
                            </svg>

                            <span>Продължи с Google</span>
                        </button>
                    }
                }
            </form>
        }






