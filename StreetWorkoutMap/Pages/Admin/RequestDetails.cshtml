@page
@model StreetWorkoutMap.Pages.Admin.RequestDetailsModel

@{
    ViewData["Title"] = Model.Request.Name;

    var original = Model.OriginalSpot;

    var hasOriginal =
        Model.IsUpdateRequest &&
        original is not null;

    var hasImages =
        Model.Request.ImageUrls.Count > 0;

    var location =
        string.IsNullOrWhiteSpace(Model.Request.District)
            ? Model.Request.City
            : $"{Model.Request.City}, {Model.Request.District}";

    var previousLocation =
        hasOriginal
            ? string.IsNullOrWhiteSpace(original!.District)
                ? original.City
                : $"{original.City}, {original.District}"
            : string.Empty;

    var requestTypeText =
        Model.IsUpdateRequest
            ? "Редакция"
            : "Нова площадка";


    // =====================================================
    // TEXT CHANGES
    // =====================================================

    var nameChanged =
        hasOriginal &&
        !string.Equals(
            Model.Request.Name,
            original!.Name,
            StringComparison.Ordinal);

    var descriptionChanged =
        hasOriginal &&
        !string.Equals(
            Model.Request.Description,
            original!.Description,
            StringComparison.Ordinal);

    var cityChanged =
        hasOriginal &&
        !string.Equals(
            Model.Request.City,
            original!.City,
            StringComparison.Ordinal);

    var districtChanged =
        hasOriginal &&
        !string.Equals(
            Model.Request.District,
            original!.District,
            StringComparison.Ordinal);

    var locationChanged =
        cityChanged || districtChanged;


    // =====================================================
    // COORDINATE CHANGES
    // =====================================================

    var coordinatesChanged =
        hasOriginal &&
        (
            Math.Abs(
                Model.Request.Latitude -
                original!.Latitude) > 0.000001
            ||
            Math.Abs(
                Model.Request.Longitude -
                original.Longitude) > 0.000001
        );


    // =====================================================
    // EQUIPMENT / FEATURE CHANGES
    // =====================================================

    var pullUpBarsChanged =
        hasOriginal &&
        Model.Request.HasPullUpBars !=
        original!.HasPullUpBars;

    var parallelBarsChanged =
        hasOriginal &&
        Model.Request.HasParallelBars !=
        original!.HasParallelBars;

    var ringsChanged =
        hasOriginal &&
        Model.Request.HasRings !=
        original!.HasRings;

    var lightingChanged =
        hasOriginal &&
        Model.Request.HasLighting !=
        original!.HasLighting;

    var indoorChanged =
        hasOriginal &&
        Model.Request.IsIndoor !=
        original!.IsIndoor;


    // =====================================================
    // IMAGE CHANGES
    // =====================================================

    var addedImages = hasOriginal
        ? Model.Request.ImageUrls
            .Where(requestImage =>
                !original!.ImageUrls.Any(originalImage =>
                    string.Equals(
                        requestImage,
                        originalImage,
                        StringComparison.OrdinalIgnoreCase)))
            .ToList()
        : [];

    var removedImages = hasOriginal
        ? original!.ImageUrls
            .Where(originalImage =>
                !Model.Request.ImageUrls.Any(requestImage =>
                    string.Equals(
                        originalImage,
                        requestImage,
                        StringComparison.OrdinalIgnoreCase)))
            .ToList()
        : [];

    var imagesChanged =
        addedImages.Count > 0 ||
        removedImages.Count > 0;

    var imageChangeParts =
        new List<string>();

    if (addedImages.Count > 0)
    {
        imageChangeParts.Add(
            $"Добавени: {addedImages.Count}");
    }

    if (removedImages.Count > 0)
    {
        imageChangeParts.Add(
            $"Премахнати: {removedImages.Count}");
    }

    var imageChangeSummary =
        string.Join(" · ", imageChangeParts);


    // =====================================================
    // TOTAL CHANGES
    // =====================================================

    var changesCount =
        (nameChanged ? 1 : 0) +
        (descriptionChanged ? 1 : 0) +
        (locationChanged ? 1 : 0) +
        (coordinatesChanged ? 1 : 0) +
        (pullUpBarsChanged ? 1 : 0) +
        (parallelBarsChanged ? 1 : 0) +
        (ringsChanged ? 1 : 0) +
        (lightingChanged ? 1 : 0) +
        (indoorChanged ? 1 : 0) +
        (imagesChanged ? 1 : 0);

    string BooleanLabel(bool value) =>
        value ? "✓ Да" : "× Не";
}


<section class="spot-details-page">

    <nav class="spot-details-breadcrumb"
         aria-label="Навигация">

        <a asp-page="/Admin/PendingSpots">
            Заявки
        </a>

        <span aria-hidden="true">›</span>

        <span>@Model.Request.Name</span>

    </nav>


    @* =====================================================
       HEADER
       ===================================================== *@

    <header class="spot-details-header">

        <div class="spot-details-heading">

            <div class="spot-details-title-row">

                <h1>@Model.Request.Name</h1>

                <span class="spot-status-badge spot-status-pending">
                    @requestTypeText
                </span>

            </div>


            @if (nameChanged)
            {
                <div class="request-previous-value
                    request-previous-value-header">

                    <span>Преди</span>

                    <strong>@original!.Name</strong>

                </div>
            }


            <p class="spot-details-location">

                <span aria-hidden="true">⌖</span>

                @location

                @if (locationChanged)
                {
                    <span class="request-inline-changed">
                        Променено
                    </span>
                }

            </p>


            @if (locationChanged)
            {
                <div class="request-previous-value">

                    <span>Преди</span>

                    <strong>@previousLocation</strong>

                </div>
            }

        </div>

    </header>


    @* =====================================================
       IMAGE CHANGE SUMMARY
       ===================================================== *@

    @if (imagesChanged)
    {
        <div class="request-gallery-change">

            <div>
                <span class="request-changed-badge">
                    Снимки
                </span>

                <strong>Галерията е променена</strong>
            </div>

            <small>
                @imageChangeSummary
            </small>

        </div>
    }


    @* =====================================================
       IMAGE GALLERY
       ===================================================== *@

    <section class="spot-gallery"
             aria-label="Снимки на площадката">

        @if (hasImages)
        {
            <div class="spot-gallery-main">

                <img id="spot-main-image"
                     src="@Model.Request.ImageUrls[0]"
                     alt="@Model.Request.Name"
                     class="spot-main-image" />

                <span id="spot-image-counter"
                      class="spot-image-counter">

                    1 / @Model.Request.ImageUrls.Count

                </span>

            </div>


            @if (Model.Request.ImageUrls.Count > 1)
            {
                <div class="spot-gallery-thumbnails">

                    @for (
                        var index = 0;
                        index < Model.Request.ImageUrls.Count;
                        index++)
                    {
                        var imageUrl =
                            Model.Request.ImageUrls[index];

                        var isAddedImage =
                            addedImages.Any(image =>
                                string.Equals(
                                    image,
                                    imageUrl,
                                    StringComparison.OrdinalIgnoreCase));

                        <button type="button"
                                class="spot-thumbnail-button
                            @(index == 0 ? "is-active" : "")
                            @(isAddedImage ? "request-image-added" : "")"
                                data-image-url="@imageUrl"
                                data-image-index="@index"
                                aria-label="Покажи снимка @(index + 1)">

                            <img src="@imageUrl"
                                 alt="Снимка @(index + 1) на @Model.Request.Name" />

                            @if (isAddedImage)
                            {
                                <span class="request-image-added-badge">
                                    Нова
                                </span>
                            }

                        </button>
                    }

                </div>
            }
        }
        else
        {
            <div class="spot-gallery-placeholder">

                <div class="spot-placeholder-icon">
                    SW
                </div>

                <h2>Няма снимки</h2>

                <p>
                    Към тази заявка няма добавени снимки.
                </p>

            </div>
        }


        @if (removedImages.Count > 0)
        {
            <div class="request-removed-images">

                <div class="request-removed-images-heading">

                    <div>
                        <strong>Премахнати снимки</strong>

                        <span>
                            Тези снимки няма да останат
                            след одобрение.
                        </span>
                    </div>

                    <span class="request-removed-count">
                        @removedImages.Count
                    </span>

                </div>


                <div class="request-removed-images-grid">

                    @foreach (var imageUrl in removedImages)
                    {
                        <figure class="request-removed-image">

                            <img src="@imageUrl"
                                 alt="Премахната снимка" />

                            <span>
                                Премахната
                            </span>

                        </figure>
                    }

                </div>

            </div>
        }

    </section>


    <div class="spot-details-layout">

        <main class="spot-details-content">


            @* =================================================
               DESCRIPTION
               ================================================= *@

            <section class="spot-details-card">

                <div class="spot-section-heading">

                    <span class="spot-section-icon"
                          aria-hidden="true">
                        i
                    </span>

                    <div>
                        <h2>За площадката</h2>
                        <p>Описание и полезна информация</p>
                    </div>

                    @if (descriptionChanged)
                    {
                        <span class="request-changed-badge
                            request-section-change-badge">
                            Променено
                        </span>
                    }

                </div>


                <div class="request-field
                    @(descriptionChanged ? "is-changed" : "")">

                    @if (!string.IsNullOrWhiteSpace(
                        Model.Request.Description))
                    {
                        <p class="spot-details-description">
                            @Model.Request.Description
                        </p>
                    }
                    else
                    {
                        <p class="spot-details-empty-text">
                            За тази площадка няма добавено описание.
                        </p>
                    }


                    @if (descriptionChanged)
                    {
                        <div class="request-previous-value
                            request-previous-block">

                            <span>Преди</span>

                            @if (!string.IsNullOrWhiteSpace(
                                original!.Description))
                            {
                                <p>
                                    @original.Description
                                </p>
                            }
                            else
                            {
                                <p>
                                    Няма описание
                                </p>
                            }

                        </div>
                    }

                </div>

            </section>


            @* =================================================
               EQUIPMENT AND FEATURES
               ================================================= *@

            <section class="spot-details-card">

                <div class="spot-section-heading">

                    <span class="spot-section-icon"
                          aria-hidden="true">
                        ✓
                    </span>

                    <div>
                        <h2>Оборудване и условия</h2>
                        <p>Какво ще има на място</p>
                    </div>

                </div>


                <div class="spot-features-grid">


                    @* PULL UP BARS *@

                    <article class="spot-feature
                        @(Model.Request.HasPullUpBars
                                 ? "is-available"
                                 : "is-unavailable")
                        @(pullUpBarsChanged
                                 ? "request-feature-changed"
                                 : "")">

                        <span class="spot-feature-status">
                            @(Model.Request.HasPullUpBars ? "✓" : "×")
                        </span>

                        <div class="request-feature-body">

                            <div class="request-feature-title-row">

                                <h3>Лостове</h3>

                                @if (pullUpBarsChanged)
                                {
                                    <span class="request-mini-badge">
                                        Променено
                                    </span>
                                }

                            </div>

                            <p>
                                Лостове за набирания и упражнения
                            </p>


                            @if (pullUpBarsChanged)
                            {
                                <div class="request-feature-previous">

                                    <span>Преди</span>

                                    <strong>
                                        @BooleanLabel(
                                            original!.HasPullUpBars)
                                    </strong>

                                </div>
                            }

                        </div>

                    </article>


                    @* PARALLEL BARS *@

                    <article class="spot-feature
                        @(Model.Request.HasParallelBars
                                 ? "is-available"
                                 : "is-unavailable")
                        @(parallelBarsChanged
                                 ? "request-feature-changed"
                                 : "")">

                        <span class="spot-feature-status">
                            @(Model.Request.HasParallelBars ? "✓" : "×")
                        </span>

                        <div class="request-feature-body">

                            <div class="request-feature-title-row">

                                <h3>Успоредка</h3>

                                @if (parallelBarsChanged)
                                {
                                    <span class="request-mini-badge">
                                        Променено
                                    </span>
                                }

                            </div>

                            <p>
                                Подходяща за кофички и опори
                            </p>


                            @if (parallelBarsChanged)
                            {
                                <div class="request-feature-previous">

                                    <span>Преди</span>

                                    <strong>
                                        @BooleanLabel(
                                            original!.HasParallelBars)
                                    </strong>

                                </div>
                            }

                        </div>

                    </article>


                    @* RINGS *@

                    <article class="spot-feature
                        @(Model.Request.HasRings
                                 ? "is-available"
                                 : "is-unavailable")
                        @(ringsChanged
                                 ? "request-feature-changed"
                                 : "")">

                        <span class="spot-feature-status">
                            @(Model.Request.HasRings ? "✓" : "×")
                        </span>

                        <div class="request-feature-body">

                            <div class="request-feature-title-row">

                                <h3>Халки</h3>

                                @if (ringsChanged)
                                {
                                    <span class="request-mini-badge">
                                        Променено
                                    </span>
                                }

                            </div>

                            <p>
                                Постоянно монтирани халки
                            </p>


                            @if (ringsChanged)
                            {
                                <div class="request-feature-previous">

                                    <span>Преди</span>

                                    <strong>
                                        @BooleanLabel(
                                            original!.HasRings)
                                    </strong>

                                </div>
                            }

                        </div>

                    </article>


                    @* LIGHTING *@

                    <article class="spot-feature
                        @(Model.Request.HasLighting
                                 ? "is-available"
                                 : "is-unavailable")
                        @(lightingChanged
                                 ? "request-feature-changed"
                                 : "")">

                        <span class="spot-feature-status">
                            @(Model.Request.HasLighting ? "✓" : "×")
                        </span>

                        <div class="request-feature-body">

                            <div class="request-feature-title-row">

                                <h3>Осветление</h3>

                                @if (lightingChanged)
                                {
                                    <span class="request-mini-badge">
                                        Променено
                                    </span>
                                }

                            </div>

                            <p>
                                Подходяща за вечерни тренировки
                            </p>


                            @if (lightingChanged)
                            {
                                <div class="request-feature-previous">

                                    <span>Преди</span>

                                    <strong>
                                        @BooleanLabel(
                                            original!.HasLighting)
                                    </strong>

                                </div>
                            }

                        </div>

                    </article>


                    @* INDOOR *@

                    <article class="spot-feature
                        @(Model.Request.IsIndoor
                                 ? "is-available"
                                 : "is-unavailable")
                        @(indoorChanged
                                 ? "request-feature-changed"
                                 : "")">

                        <span class="spot-feature-status">
                            @(Model.Request.IsIndoor ? "✓" : "×")
                        </span>

                        <div class="request-feature-body">

                            <div class="request-feature-title-row">

                                <h3>Закрита площадка</h3>

                                @if (indoorChanged)
                                {
                                    <span class="request-mini-badge">
                                        Променено
                                    </span>
                                }

                            </div>

                            <p>
                                На закрито или под постоянен навес
                            </p>


                            @if (indoorChanged)
                            {
                                <div class="request-feature-previous">

                                    <span>Преди</span>

                                    <strong>
                                        @BooleanLabel(
                                            original!.IsIndoor)
                                    </strong>

                                </div>
                            }

                        </div>

                    </article>

                </div>

            </section>


            @* =================================================
               LOCATION
               ================================================= *@

            <section class="spot-details-card">

                <div class="spot-section-heading">

                    <span class="spot-section-icon"
                          aria-hidden="true">
                        ⌖
                    </span>

                    <div>
                        <h2>Местоположение</h2>
                        <p>@location</p>
                    </div>


                    @if (coordinatesChanged)
                    {
                        <span class="request-changed-badge
                            request-section-change-badge">
                            Променено
                        </span>
                    }

                </div>


                <div id="details-spot-map"
                     data-latitude="@Model.Request.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                     data-longitude="@Model.Request.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                     data-spot-name="@Model.Request.Name">
                </div>


                <div class="spot-map-actions">

                    <a id="spot-directions-link"
                       class="spot-directions-link"
                       href="#"
                       target="_blank"
                       rel="noopener noreferrer">

                        <span aria-hidden="true">➜</span>

                        Отвори в Google Maps

                    </a>


                    <p class="spot-coordinates">

                        @Model.Request.Latitude.ToString("F6"),
                        @Model.Request.Longitude.ToString("F6")

                    </p>

                </div>


                @if (coordinatesChanged)
                {
                    <div class="request-coordinate-previous">

                        <span>Преди</span>

                        <strong>
                            @original!.Latitude.ToString("F6"),
                            @original.Longitude.ToString("F6")
                        </strong>

                    </div>
                }

            </section>

        </main>


        @* =====================================================
           SIDEBAR
           ===================================================== *@

        <aside class="spot-details-sidebar">

            <section class="spot-summary-card">

                <h2>Информация</h2>

                <dl class="spot-summary-list">

                    <div>
                        <dt>Град</dt>
                        <dd>@Model.Request.City</dd>
                    </div>


                    @if (!string.IsNullOrWhiteSpace(
                        Model.Request.District))
                    {
                        <div>
                            <dt>Квартал или район</dt>

                            <dd>
                                @Model.Request.District
                            </dd>
                        </div>
                    }


                    <div>
                        <dt>Тип заявка</dt>

                        <dd>
                            <span class="spot-summary-status
                                spot-status-pending">

                                @requestTypeText

                            </span>
                        </dd>
                    </div>


                    @if (Model.IsUpdateRequest)
                    {
                        <div>
                            <dt>Променени елементи</dt>

                            <dd>
                                <span class="request-change-count">
                                    @changesCount
                                </span>
                            </dd>
                        </div>
                    }

                </dl>

            </section>


            <section class="spot-notice-card">

                <span class="spot-notice-icon"
                      aria-hidden="true">
                    !
                </span>

                <div>

                    <h2>Очаква проверка</h2>

                    <p>
                        Заявката все още не е обработена
                        от администратор.
                    </p>

                </div>

            </section>


            <section class="spot-admin-card">

                <div class="spot-admin-heading">

                    <span class="spot-admin-icon"
                          aria-hidden="true">
                        ✓
                    </span>

                    <div>

                        <h2>Административни действия</h2>

                        <p>
                            Прегледай информацията
                            преди решение.
                        </p>

                    </div>

                </div>


                <p class="spot-admin-description">

                    @if (Model.IsUpdateRequest)
                    {
                        <text>
                            При одобрение предложените промени
                            ще заменят текущата версия
                            на площадката.
                        </text>
                    }
                    else
                    {
                        <text>
                            При одобрение площадката
                            ще стане видима
                            за всички потребители.
                        </text>
                    }

                </p>


                <div class="spot-admin-actions">

                    <form method="post"
                          asp-page-handler="Approve">

                        <input type="hidden"
                               name="id"
                               value="@Model.Request.Id" />

                        <input type="hidden"
                               name="isUpdate"
                               value="@Model.IsUpdateRequest.ToString().ToLowerInvariant()" />

                        <button type="submit"
                                class="spot-admin-approve-button">

                            <span aria-hidden="true">✓</span>

                            Одобри заявката

                        </button>

                    </form>


                    <form method="post"
                          asp-page-handler="Reject"
                          id="reject-request-form">

                        <input type="hidden"
                               name="id"
                               value="@Model.Request.Id" />

                        <input type="hidden"
                               name="isUpdate"
                               value="@Model.IsUpdateRequest.ToString().ToLowerInvariant()" />

                        <button type="button"
                                class="spot-admin-reject-button"
                                id="open-reject-modal">

                            <span aria-hidden="true">×</span>

                            Откажи заявката

                        </button>

                    </form>

                </div>

            </section>

        </aside>

    </div>

</section>


<div class="request-confirm-backdrop"
     id="reject-modal"
     hidden>

    <div class="request-confirm-modal"
         role="dialog"
         aria-modal="true"
         aria-labelledby="reject-modal-title">

        <div class="request-confirm-icon"
             aria-hidden="true">
            !
        </div>

        <div class="request-confirm-content">

            <h2 id="reject-modal-title">
                Отказ на заявката
            </h2>

            <p>
                Сигурен ли си, че искаш да откажеш
                заявката за
                <strong>@Model.Request.Name</strong>?
            </p>

            @if (Model.IsUpdateRequest)
            {
                <small>
                    Предложените промени ще бъдат изтрити,
                    а текущата площадка ще остане непроменена.
                </small>
            }
            else
            {
                <small>
                    Площадката и качените към нея снимки
                    ще бъдат изтрити.
                </small>
            }

        </div>

        <div class="request-confirm-actions">

            <button type="button"
                    class="request-confirm-cancel"
                    id="cancel-reject">
                Назад
            </button>

            <button type="button"
                    class="request-confirm-reject"
                    id="confirm-reject">
                Да, откажи
            </button>

        </div>

    </div>

</div>



@section Scripts {

    <script src="~/js/details-spot.js"
            asp-append-version="true">
    </script>


    <script>
        document.addEventListener("DOMContentLoaded", () => {

            const rejectModal =
                document.getElementById("reject-modal");

            const openRejectModal =
                document.getElementById("open-reject-modal");

            const cancelReject =
                document.getElementById("cancel-reject");

            const confirmReject =
                document.getElementById("confirm-reject");

            const rejectForm =
                document.getElementById("reject-request-form");

            if (
                !rejectModal ||
                !openRejectModal ||
                !cancelReject ||
                !confirmReject ||
                !rejectForm
            ) {
                return;
            }

            function openModal() {
                rejectModal.hidden = false;

                document.body.classList.add(
                    "request-modal-open");
            }

            function closeModal() {
                rejectModal.hidden = true;

                document.body.classList.remove(
                    "request-modal-open");
            }

            openRejectModal.addEventListener(
                "click",
                event => {

                    event.preventDefault();

                    openModal();
                });

            cancelReject.addEventListener(
                "click",
                closeModal);

            confirmReject.addEventListener(
                "click",
                () => {

                    closeModal();

                    rejectForm.requestSubmit();
                });

            rejectModal.addEventListener(
                "click",
                event => {

                    if (event.target === rejectModal) {
                        closeModal();
                    }
                });

            document.addEventListener(
                "keydown",
                event => {

                    if (
                        event.key === "Escape" &&
                        !rejectModal.hidden
                    ) {
                        closeModal();
                    }
                });
        });
    </script>


}