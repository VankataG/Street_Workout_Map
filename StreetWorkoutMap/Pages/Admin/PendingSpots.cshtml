@page
@model StreetWorkoutMap.Pages.Admin.PendingSpotsModel

@{
    ViewData["Title"] = "Чакащи заявки";
}

<section class="pending-spots-page">

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="pending-success-message"
             role="status">

            <span class="pending-success-icon"
                  aria-hidden="true">
                ✓
            </span>

            <div>
                <strong>Готово</strong>
                <p>@successMessage</p>
            </div>

            <button type="button"
                    class="pending-success-close"
                    aria-label="Затвори съобщението">
                ×
            </button>

        </div>
    }

    <header class="pending-spots-header">
        <div>
            <p class="pending-spots-eyebrow">
                Администрация
            </p>

            <h1>Чакащи заявки</h1>

            <p class="pending-spots-description">
                Прегледай новите площадки и предложените редакции,
                преди промените да станат видими за всички потребители.
            </p>
        </div>

        @if (Model.PendingRequests.Count > 0)
        {
            <div class="pending-spots-count">
                <span>@Model.PendingRequests.Count</span>

                @(Model.PendingRequests.Count == 1
                    ? "чакаща заявка"
                    : "чакащи заявки")
            </div>
        }
    </header>

    @if (Model.PendingRequests.Count == 0)
    {
        <div class="pending-spots-empty">

            <div class="pending-spots-empty-icon">
                ✓
            </div>

            <h2>Няма чакащи заявки</h2>

            <p>
                В момента всички изпратени заявки са прегледани.
            </p>

            <a asp-page="/Index"
               class="pending-spots-back-button">
                Към картата
            </a>

        </div>
    }
    else
    {
        <div class="pending-spots-grid">

            @foreach (var request in Model.PendingRequests)
            {
                <article class="pending-spot-card">

                    <div class="pending-spot-media">

                        @if (!string.IsNullOrWhiteSpace(request.ImageUrl))
                        {
                            <img src="@request.ImageUrl"
                                 alt="@request.Name"
                                 class="pending-spot-image" />
                        }
                        else
                        {
                            <div class="pending-spot-placeholder">
                                <span>SW-MAP</span>
                                <small>Няма снимка</small>
                            </div>
                        }

                    </div>

                    <div class="pending-spot-content">

                        <div class="pending-request-type">
                            @if (request.IsUpdateRequest)
                            {
                                <span class="pending-request-badge pending-request-badge-edit">
                                    Редакция
                                </span>
                            }
                            else
                            {
                                <span class="pending-request-badge pending-request-badge-new">
                                    Нова площадка
                                </span>
                            }
                        </div>

                        <div class="pending-spot-main">
                            <h2>@request.Name</h2>

                            <p class="pending-spot-location">
                                <span aria-hidden="true">⌖</span>

                                @request.City

                                @if (!string.IsNullOrWhiteSpace(request.District))
                                {
                                    <text> · @request.District</text>
                                }
                            </p>
                        </div>

                        <div class="pending-spot-submitter">
                            <span class="pending-spot-user-icon"
                                  aria-hidden="true">
                                @(
                                    string.IsNullOrWhiteSpace(request.SubmittedByName)
                                        ? "?"
                                        : request.SubmittedByName[..1].ToUpper()
                                )
                            </span>

                            <div>
                                <small>Заявка от</small>
                                <strong>@request.SubmittedByName</strong>
                            </div>
                        </div>

                        <a asp-page="/Admin/RequestDetails"
                           asp-route-id="@request.Id"
                           asp-route-isUpdate="@request.IsUpdateRequest"
                           class="pending-spot-details-button">
                            Прегледай заявката
                            <span aria-hidden="true">→</span>
                        </a>

                    </div>

                </article>
            }

        </div>
    }

</section>


@section Scripts {
    <script>
        document
            .querySelector(".pending-success-close")
            ?.addEventListener("click", function () {
                this.closest(".pending-success-message")?.remove();
            });
    </script>
}