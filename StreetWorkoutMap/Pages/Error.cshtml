@page
@model ErrorModel

@{
    ViewData["Title"] = "Възникна грешка";
}

<section class="error-page">

    <div class="error-card">

        <div class="error-code error-code-danger">
            !
        </div>

        <div class="error-eyebrow">
            SW-MAP
        </div>

        <h1>Нещо се обърка</h1>

        <p class="error-description">
            Възникна неочаквана грешка при обработката на заявката.
            Опитай отново след малко.
        </p>

        <div class="error-actions">

            <a asp-page="/Index"
               class="error-primary-button">
                Към картата
            </a>

            <button type="button"
                    class="error-secondary-button"
                    onclick="window.location.reload()">
                Опитай отново
            </button>

        </div>

        @if (Model.ShowRequestId)
        {
            <div class="error-request">

                <span>Код на заявката</span>

                <code>@Model.RequestId</code>

                <small>
                    Ако проблемът продължава, можеш да изпратиш този код
                    на sw.map.eu@gmail.com.
                </small>

            </div>
        }

    </div>

</section>