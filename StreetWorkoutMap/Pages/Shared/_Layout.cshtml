@using Microsoft.AspNetCore.Identity
@using StreetWorkoutMap.Data
@using StreetWorkoutMap.Services.Contrancts

@inject IWorkoutSpotService WorkoutSpotService
@inject IWorkoutSpotUpdateRequestService WorkoutSpotUpdateRequestService
@inject SignInManager<ApplicationUser> SignInManager



@{
    var pendingRequestsCount = 0;

    if (User.IsInRole("Admin"))
    {
        var pendingSpotsCount =
            await WorkoutSpotService.GetPendingSpotsCountAsync();

        var pendingUpdateRequestsCount =
            await WorkoutSpotUpdateRequestService.GetPendingRequestsCountAsync();

        pendingRequestsCount =
            pendingSpotsCount + pendingUpdateRequestsCount;
    }
}




<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StreetWorkoutMap</title>
    <link rel="icon"
          type="image/png"
          href="~/images/logo/navbar_icon.png"
          asp-append-version="true" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StreetWorkoutMap.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster/dist/MarkerCluster.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster/dist/MarkerCluster.Default.css" />
</head>
<body>

    <div id="analytics-consent"
         class="analytics-consent"
         hidden>

        <div class="analytics-consent-content">
            <div>
                <strong>Бисквитки и анализи</strong>

                <p>
                    Използваме Google Analytics, за да разбираме
                    как се използва SW-MAP и да подобряваме сайта.
                </p>

                <a asp-area="" asp-page="/Privacy">
                    Научи повече
                </a>
            </div>

            <div class="analytics-consent-actions">
                <button id="analytics-reject"
                        type="button"
                        class="analytics-consent-reject">
                    Отказвам
                </button>

                <button id="analytics-accept"
                        type="button"
                        class="analytics-consent-accept">
                    Приемам
                </button>
            </div>
        </div>
    </div>


    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-page="/Index">
                    <img id="site-logo"
                         src="~/images/logo/icon.png"
                         asp-append-version="true"
                         alt="SW-MAP"
                         class="site-logo" />
                </a>

                @if (User.Identity?.IsAuthenticated != true)
                {
                    <a class="mobile-register-link"
                       asp-area="Identity"
                       asp-page="/Account/Register">
                        РЕГИСТРАЦИЯ
                    </a>
                }

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.Identity?.IsAuthenticated == true)
                            {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Spots/Create">Добави площадка</a>
                            </li>
                            }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark admin-requests-link"
                                   asp-area=""
                                   asp-page="/Admin/PendingSpots">

                                    <span>Заявки</span>

                                    @if (pendingRequestsCount > 0)
                                    {
                                        <span class="admin-requests-count">
                                            @(pendingRequestsCount > 99
                                                ? "99+"
                                                : pendingRequestsCount)
                                        </span>
                                    }

                                </a>
                            </li>
                        }

                        
                    </ul>
                    <button id="theme-toggle"
                            class="btn btn-outline-secondary me-sm-2"
                            type="button"
                            aria-label="Смени темата">
                        🌙
                    </button>

                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container footer-content">

            <div class="footer-brand">
                <span>© 2026</span>
                <strong>SW-MAP</strong>
                <span class="footer-separator">•</span>
                <span>Street Workout Map Bulgaria</span>
            </div>

            <div class="footer-right">
                <div class="footer-contact">
                    <span>Забеляза бъг или нещо не работи както трябва?</span>
                    <a href="mailto:sw.map.eu@gmail.com">Пиши ни спокойно.</a>
                </div>

                <a class="footer-link" asp-area="" asp-page="/Privacy">
                    Поверителност
                </a>

                <button id="analytics-settings"
                        type="button"
                        class="footer-link analytics-settings-button">
                    Настройки за бисквитки
                </button>
            </div>

        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
    <script src="https://unpkg.com/leaflet.markercluster/dist/leaflet.markercluster.js"></script>

    <script>
            const analyticsMeasurementId = "G-4F9L10J0ZV";
            const analyticsConsentKey = "swmap-analytics-consent";

            const consentBanner =
                document.getElementById("analytics-consent");

            const acceptButton =
                document.getElementById("analytics-accept");

            const rejectButton =
                document.getElementById("analytics-reject");

            const settingsButton =
                document.getElementById("analytics-settings");

            const savedConsent =
                localStorage.getItem(analyticsConsentKey);

            if (savedConsent === "accepted") {
                loadGoogleAnalytics();
            }
            else if (savedConsent !== "rejected") {
                consentBanner.hidden = false;
            }

            acceptButton.addEventListener("click", () => {
                localStorage.setItem(
                    analyticsConsentKey,
                    "accepted"
                );

                consentBanner.hidden = true;

                loadGoogleAnalytics();
            });

            rejectButton.addEventListener("click", () => {
                localStorage.setItem(
                    analyticsConsentKey,
                    "rejected"
                );

                consentBanner.hidden = true;
            });

            settingsButton.addEventListener("click", () => {
                localStorage.removeItem(analyticsConsentKey);

                consentBanner.hidden = false;
            });

            function loadGoogleAnalytics() {
                if (window.swMapAnalyticsLoaded) {
                    return;
                }

                window.swMapAnalyticsLoaded = true;

                window.dataLayer = window.dataLayer || [];

                function gtag() {
                    dataLayer.push(arguments);
                }

                window.gtag = gtag;

                gtag("js", new Date());

                gtag("consent", "default", {
                    analytics_storage: "granted",
                    ad_storage: "denied",
                    ad_user_data: "denied",
                    ad_personalization: "denied"
                });

                gtag("config", analyticsMeasurementId);

                const script = document.createElement("script");

                script.async = true;
                script.src =
                    "https://www.googletagmanager.com/gtag/js?id="
                    + analyticsMeasurementId;

                document.head.appendChild(script);
            }
    </script>


    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
